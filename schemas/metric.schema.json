{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cooperalink per-origin metric record",
  "type": "object",
  "required": [
    "run_id",
    "model_id",
    "origin",
    "slice",
    "metric",
    "value",
    "reason",
    "candidate_count",
    "positive_count",
    "negative_count"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "format": "date"
    },
    "slice": {
      "enum": [
        "all_pairs",
        "active_last_30",
        "inactive_last_30"
      ]
    },
    "metric": {
      "enum": [
        "roc_auc",
        "average_precision",
        "precision_at_k",
        "filtered_mrr",
        "brier_score"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "positive_count": {
      "type": "integer",
      "minimum": 0
    },
    "negative_count": {
      "type": "integer",
      "minimum": 0
    },
    "requested_k": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "effective_k": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "positive_query_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "filtered_mrr"
          }
        }
      },
      "then": {
        "properties": {
          "slice": {
            "const": "all_pairs"
          },
          "positive_query_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "positive_query_count"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "metric": {
            "const": "precision_at_k"
          }
        }
      },
      "then": {
        "required": [
          "requested_k",
          "effective_k"
        ],
        "properties": {
          "requested_k": {
            "type": "integer",
            "minimum": 1
          },
          "effective_k": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
